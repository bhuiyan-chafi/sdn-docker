# Assign the control plane IP address (Domain A)
# Used for ONOS management and for ping tests from onosnode / parentswitch
ip addr add 131.114.54.75/24 dev eth0

# Start the Open vSwitch service
/etc/init.d/openvswitch-switch start

# Create the OVS bridge and point it to the ONOS controller (via Domain A)
ovs-vsctl add-br br0
ovs-vsctl set-controller br0 tcp:131.114.54.73:6653

# Add the data plane port (Domain B — physical link to parentswitch)
ovs-vsctl add-port br0 eth1

# Create an OVS internal port for the 192.168.1.0/24 uplink subnet.
# This gives lswitch1 an IP on the same subnet as parentswitch's gw-b (192.168.1.10),
# enabling data-plane reachability between the two switches.
ovs-vsctl add-port br0 uplink -- set interface uplink type=internal
ip link set uplink up
ip addr add 192.168.1.20/24 dev uplink

# Add VLAN access ports for the hosts
# 'tag=N' puts the port in access mode: incoming untagged frames from host
# are stamped with VLAN N internally; outgoing frames have the tag stripped.
ovs-vsctl add-port br0 eth2 tag=100   # pc1 — vlan 100
ovs-vsctl add-port br0 eth3 tag=200   # pc2 — vlan 200

# Create OVS internal ports so lswitch1 itself has an IP on each VLAN.
# These act as the per-VLAN gateway interfaces of the switch.
ovs-vsctl add-port br0 vlan100-gw tag=100 -- set interface vlan100-gw type=internal
ovs-vsctl add-port br0 vlan200-gw tag=200 -- set interface vlan200-gw type=internal

ip link set vlan100-gw up
ip link set vlan200-gw up
ip addr add 10.10.1.254/24 dev vlan100-gw
ip addr add 10.10.1.253/24 dev vlan200-gw

# Policy routing — both VLANs share the 10.10.1.0/24 subnet, which would
# confuse the kernel (two routes to the same prefix on two interfaces).
# Source-based routing tables ensure each interface uses its own path:
#   table 100 → always egress via vlan100-gw (reaches pc1)
#   table 200 → always egress via vlan200-gw (reaches pc2)
ip rule add from 10.10.1.254 lookup 100
ip route add 10.10.1.0/24 dev vlan100-gw table 100
ip rule add from 10.10.1.253 lookup 200
ip route add 10.10.1.0/24 dev vlan200-gw table 200

# Force OpenFlow 1.3 and 1.4 compatibility (required by modern ONOS)
ovs-vsctl set bridge br0 protocols=OpenFlow13,OpenFlow14

# Standalone fail mode: OVS acts as a normal learning switch if controller is lost.
ovs-vsctl set bridge br0 fail_mode=standalone

# --- ONOS Bypass Daemon ---
# The default ONOS 'fwd' app does not correctly bridge between OVS internal ports
# and VLAN access ports. It also aggressively wipes unknown flows.
# This daemon continuously re-adds a priority NORMAL rule to bypass ONOS for local
# forwarding, while allowing the switch to remain connected so it shows in the GUI.
nohup bash -c 'while true; do ovs-ofctl add-flow br0 "priority=50000,actions=NORMAL" -O OpenFlow13 2>/dev/null; sleep 1; done' >/dev/null 2>&1 &
